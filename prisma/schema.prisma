// PlayBeat CRM — Communication Center Prisma Schema
// Models: User, Lead, Segment, Campaign, CampaignRecipient, Message, Conversation,
// Template, Suppression, WebhookEvent, Integration, AuditLog, Setting,
// Call, Note, Task, Followup, Notification, PhoneNumber

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
  // On Vercel/serverless, the database file is written to /tmp which is the only writable directory.
  // The DATABASE_URL env var should be set to file:/tmp/custom.db on Vercel.
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  password        String
  role            String    @default("VIEWER") // SUPER_ADMIN | ADMIN | MANAGER | TEAM_LEADER | EMPLOYEE | SUPPORT | VIEWER
  active          Boolean   @default(true)
  // Employee fields
  employeeCode    String?
  availability    String    @default("OFFLINE") // ONLINE | AWAY | BUSY | OFFLINE
  title           String?   // e.g. "CRM Manager"
  avatar          String?
  phone           String?
  lastLogin       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([email])
  @@index([availability])
}

model Lead {
  id                String    @id @default(cuid())
  businessName      String
  contactPerson     String?
  email             String?
  whatsapp          String?
  phone             String?
  country           String?
  state             String?
  city              String?
  category          String?
  industry          String?
  website           String?
  source            String?
  tags              String    @default("[]") // JSON array
  status            String    @default("NEW") // NEW | CONTACTED | RESPONDED | QUALIFIED | PROPOSAL | NEGOTIATION | WON | LOST | FOLLOW_UP | CONVERTED | DO_NOT_CONTACT
  score             Int       @default(0)
  emailVerified     Boolean   @default(false)
  whatsappAvailable Boolean   @default(false)
  emailOptIn        Boolean   @default(false)
  whatsappOptIn     Boolean   @default(false)
  doNotContact      Boolean   @default(false)
  // CRM assignment
  assignedTo        String?   // User ID of assigned employee
  assignedToName    String?
  assignedAt        DateTime?
  lastContacted     DateTime?
  lastReplied       DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([email])
  @@index([whatsapp])
  @@index([phone])
  @@index([businessName])
  @@index([city])
  @@index([category])
  @@index([status])
  @@index([source])
  @@index([assignedTo])
}

model Segment {
  id          String   @id @default(cuid())
  name        String
  description String?
  filters     String   @default("{}") // JSON filter spec
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Campaign {
  id          String    @id @default(cuid())
  name        String
  channel     String    // WHATSAPP | EMAIL | COMBINED
  segmentId   String?
  segmentName String?
  subject     String?
  message     String
  templateId  String?
  attachments String    @default("[]") // JSON array
  scheduledAt DateTime?
  status      String    @default("DRAFT") // DRAFT | SCHEDULED | QUEUED | RUNNING | PAUSED | COMPLETED | CANCELLED | FAILED
  createdBy   String
  createdByName String?
  startedAt   DateTime?
  completedAt DateTime?
  stats       String    @default("{}") // JSON: { sent, delivered, read, failed, total }
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([channel])
}

model CampaignRecipient {
  id          String    @id @default(cuid())
  campaignId  String
  leadId      String
  leadName    String?
  leadEmail   String?
  leadPhone   String?
  status      String    @default("QUEUED") // QUEUED | SENT | DELIVERED | READ | FAILED | REJECTED
  messageId   String?
  providerId  String?
  error       String?
  queuedAt    DateTime  @default(now())
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  failedAt    DateTime?

  @@index([campaignId])
  @@index([leadId])
  @@index([status])
}

model Message {
  id          String   @id @default(cuid())
  leadId      String?
  conversationId String?
  channel     String   // WHATSAPP | EMAIL
  direction   String   // INBOUND | OUTBOUND
  campaignId  String?
  messageId   String?
  subject     String?
  body        String
  providerId  String?
  status      String   @default("PENDING") // PENDING | SENT | DELIVERED | READ | FAILED | REJECTED
  error       String?
  createdAt   DateTime @default(now())

  @@index([leadId])
  @@index([conversationId])
  @@index([campaignId])
  @@index([channel])
  @@index([createdAt])
}

model Conversation {
  id            String    @id @default(cuid())
  leadId        String
  leadName      String?
  leadPhone     String?
  leadEmail     String?
  channel       String    // WHATSAPP | EMAIL
  status        String    @default("ACTIVE") // ACTIVE | ARCHIVED
  assignedTo    String?
  unreadCount   Int       @default(0)
  lastMessage   String?
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([leadId])
  @@index([status])
}

model Template {
  id          String   @id @default(cuid())
  name        String
  channel     String   // WHATSAPP | EMAIL
  language    String   @default("en")
  category    String   @default("MARKETING") // MARKETING | UTILITY | AUTHENTICATION
  subject     String?
  body        String
  variables   String   @default("[]") // JSON array of variable names
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Suppression {
  id        String   @id @default(cuid())
  type      String   // EMAIL | WHATSAPP | GLOBAL
  value     String   // email or phone
  reason    String   // UNSUBSCRIBE | BOUNCE | COMPLAINT | MANUAL
  createdAt DateTime @default(now())

  @@unique([type, value])
}

model WebhookEvent {
  id        String   @id @default(cuid())
  provider  String   // WHATSAPP | EMAIL
  eventId   String?
  payload   String   // JSON
  processed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([provider])
  @@index([eventId])
}

model Integration {
  id        String    @id @default(cuid())
  provider  String    @unique // WHATSAPP | EMAIL
  config    String    @default("{}") // JSON with masked secrets
  status    String    @default("DISCONNECTED") // CONNECTED | DISCONNECTED | ERROR
  lastSync  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  action    String
  entity    String
  entityId  String?
  details   String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String   // SYSTEM | WHATSAPP | EMAIL | NOTIFICATION
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── PlayBeat CRM Communication Center models ─────────────────────────────

model Call {
  id              String    @id @default(cuid())
  leadId          String?
  leadName        String?
  leadPhone       String?
  conversationId  String?
  employeeId      String?
  employeeName    String?
  direction       String    // INBOUND | OUTBOUND
  status          String    @default("INITIATING") // INITIATING | RINGING | CONNECTED | ON_HOLD | ENDED | FAILED | MISSED | DECLINED | BUSY | NO_ANSWER
  phone           String
  channel         String    @default("TELEPHONY") // TELEPHONY | WHATSAPP_VOICE
  durationSec     Int       @default(0)
  outcome         String?   // CONNECTED | NO_ANSWER | BUSY | WRONG_NUMBER | CALL_BACK | INTERESTED | NOT_INTERESTED | QUALIFIED | FOLLOW_UP_REQUIRED
  outcomeNotes    String?
  nextFollowupAt  DateTime?
  recordingUrl    String?
  provider        String?   // twilio | vonage | mock
  providerCallId  String?
  startedAt       DateTime  @default(now())
  connectedAt     DateTime?
  endedAt         DateTime?
  createdAt       DateTime  @default(now())

  @@index([leadId])
  @@index([employeeId])
  @@index([status])
  @@index([direction])
  @@index([startedAt])
}

model Note {
  id          String   @id @default(cuid())
  leadId      String
  employeeId  String?
  employeeName String?
  body        String
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([leadId])
  @@index([employeeId])
  @@index([createdAt])
}

model Task {
  id          String    @id @default(cuid())
  leadId      String?
  employeeId  String?
  employeeName String?
  title       String
  description String?
  dueDate     DateTime?
  status      String    @default("OPEN") // OPEN | IN_PROGRESS | DONE | CANCELLED
  priority    String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([leadId])
  @@index([employeeId])
  @@index([status])
  @@index([dueDate])
}

model Followup {
  id          String    @id @default(cuid())
  leadId      String
  leadName    String?
  employeeId  String?
  employeeName String?
  scheduledAt DateTime
  channel     String    @default("WHATSAPP") // WHATSAPP | CALL | EMAIL | IN_PERSON
  status      String    @default("SCHEDULED") // SCHEDULED | COMPLETED | CANCELLED | OVERDUE
  notes       String?
  callId      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([leadId])
  @@index([employeeId])
  @@index([status])
  @@index([scheduledAt])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String   // recipient user id
  type        String   // NEW_WHATSAPP | INCOMING_CALL | MISSED_CALL | NEW_LEAD | LEAD_ASSIGNED | FOLLOWUP_DUE | CUSTOMER_REPLY | MESSAGE_FAILED | CALL_FAILED
  title       String
  body        String?
  read        Boolean  @default(false)
  entityId    String?
  entityType  String?  // LEAD | CONVERSATION | CALL | CAMPAIGN
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model PhoneNumber {
  id           String   @id @default(cuid())
  number       String   @unique
  friendlyName String?
  country      String?
  provider     String   @default("mock") // mock | twilio | vonage
  capabilities String   @default("[]") // JSON array: ["voice","sms","whatsapp"]
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([provider])
  @@index([active])
}

// ─── PlayBeat Digital Commerce models ───────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([active])
}

model Product {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?
  longDescription String?
  categoryId    String?
  categoryName  String?
  price         Float
  salePrice     Float?
  cost          Float?
  currency      String   @default("PKR")
  type          String   @default("DIGITAL") // DIGITAL | SUBSCRIPTION | GIFT_CARD | SOFTWARE | GAMING | HARDWARE | SERVICE
  deliveryType  String   @default("INSTANT") // INSTANT | MANUAL | PHYSICAL
  stock         Int      @default(0)
  unlimited     Boolean  @default(false)
  licenseSource String?  // supplier/source for digital licenses
  images        String   @default("[]") // JSON array of URLs
  variants      String   @default("[]") // JSON array
  status        String   @default("ACTIVE") // ACTIVE | DRAFT | ARCHIVED
  featured      Boolean  @default(false)
  visibility    String   @default("PUBLIC") // PUBLIC | HIDDEN
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([slug])
  @@index([categoryId])
  @@index([status])
  @@index([featured])
  @@index([type])
}

model Order {
  id              String    @id @default(cuid())
  orderNumber     String    @unique
  customerId      String?   // Lead ID (customers are stored as Lead records)
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  customerWhatsapp String?
  items           String    @default("[]") // JSON array of {productId, name, price, qty, type}
  subtotal        Float     @default(0)
  discount        Float     @default(0)
  tax             Float     @default(0)
  shipping        Float     @default(0)
  total           Float     @default(0)
  currency        String    @default("PKR")
  paymentMethod   String?   // CARD | EASYPAISA | JAZZCASH | BANK | CRYPTO
  paymentStatus   String    @default("PENDING") // PENDING | AUTHORIZED | PAID | FAILED | REFUNDED
  fulfillmentStatus String  @default("NEW") // NEW | PROCESSING | FULFILLED | COMPLETED | CANCELLED | REFUNDED
  notes           String?
  source          String    @default("STOREFRONT") // STOREFRONT | CRM | ADMIN
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([customerId])
  @@index([orderNumber])
  @@index([paymentStatus])
  @@index([fulfillmentStatus])
  @@index([createdAt])
}

model Payment {
  id              String   @id @default(cuid())
  orderId         String
  orderNumber     String?
  amount          Float
  currency        String   @default("PKR")
  method          String   // CARD | EASYPAISA | JAZZCASH | BANK | CRYPTO
  status          String   @default("PENDING") // PENDING | AUTHORIZED | PAID | FAILED | REFUNDED
  provider        String?  // stripe | easypaisa | jazzcash | etc.
  providerTxnId   String?
  providerResponse String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([providerTxnId])
}

model License {
  id              String   @id @default(cuid())
  productId       String
  productName     String?
  licenseKey      String
  licenseData     String?  // JSON: additional fields like expiry, seats, etc.
  supplier        String?
  status          String   @default("AVAILABLE") // AVAILABLE | RESERVED | DELIVERED | ACTIVATED | EXPIRED | REVOKED
  orderId         String?  // order that consumed this license
  customerId      String?  // customer who received this license
  deliveredAt     DateTime?
  activatedAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([productId])
  @@index([status])
  @@index([orderId])
  @@index([customerId])
}

// ─── PlayBeat Digital Commerce models (additions) ───────────────────────────
// Category, Product, Order, Payment, License models already exist above.
// Adding Subscription and Discount models.

model Subscription {
  id              String    @id @default(cuid())
  customerId      String?
  customerEmail   String?
  productId       String?
  productName     String?
  plan            String?   // MONTHLY | YEARLY | LIFETIME
  status          String    @default("ACTIVE") // ACTIVE | SUSPENDED | CANCELLED | EXPIRED
  startedAt       DateTime  @default(now())
  expiresAt       DateTime?
  autoRenew       Boolean   @default(false)
  orderId         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([customerId])
  @@index([status])
}

model Discount {
  id              String    @id @default(cuid())
  code            String    @unique
  description     String?
  type            String    @default("PERCENTAGE") // PERCENTAGE | FIXED
  value           Float
  minOrder        Float?
  maxDiscount     Float?
  usageLimit      Int?
  usageCount      Int       @default(0)
  active          Boolean   @default(true)
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([code])
  @@index([active])
}
